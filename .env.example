# ==============================================================================
# NEUROTEACH AI - Environment Configuration Example
# Copy this file to .env and configure secrets appropriately.
# ==============================================================================

# Server Environment
ENVIRONMENT=development
DEBUG=True
PORT=8000
HOST=0.0.0.0
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://neuroteach:neuroteach@localhost:5432/neuroteach_db

# Security & Auth
JWT_SECRET_KEY=change_this_to_a_secure_random_hex_key_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Fine-Tuned Model Inference Endpoint (Adaption AutoScientist / vLLM / Hosted)
MODEL_ENDPOINT_URL=http://localhost:8080/v1/chat/completions
MODEL_API_KEY=
MODEL_TIMEOUT_SECONDS=15
MODEL_MAX_RETRIES=2

# Adaption AutoScientist Platform Integration (Backend-only, never expose to frontend)
ADAPTION_API_KEY=
ADAPTION_DRY_RUN=True
ADAPTION_TIMEOUT_SECONDS=60
ADAPTION_MAX_RETRIES=3

# Teacher LLM for Dataset Generation (e.g. Anthropic/OpenAI/Gemini for offline synthetic pipeline)
OFFLINE_TEACHER_API_KEY=
OFFLINE_JUDGE_API_KEY=
